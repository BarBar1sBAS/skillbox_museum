{
  "name": "muzei",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "tsc -b && bunx --bun vite build",
    "lint": "oxlint",
    "preview": "bunx --bun vite preview",
